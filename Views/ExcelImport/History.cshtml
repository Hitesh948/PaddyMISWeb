@using System.Data

@model System.Data.DataTable

@{
    ViewData["Title"] = "Import History";

    int totalImports = Model?.Rows.Count ?? 0;

    int totalImported = 0;
    int totalSkipped = 0;
    int totalRows = 0;

    if (Model != null)
    {
        foreach (DataRow row in Model.Rows)
        {
            totalRows +=
                row["TotalRows"] == DBNull.Value
                    ? 0
                    : Convert.ToInt32(row["TotalRows"]);

            totalImported +=
                row["ImportedRows"] == DBNull.Value
                    ? 0
                    : Convert.ToInt32(row["ImportedRows"]);

            totalSkipped +=
                row["SkippedRows"] == DBNull.Value
                    ? 0
                    : Convert.ToInt32(row["SkippedRows"]);
        }
    }
}

<style>

    body {
        background: #f5f7f9;
    }

    .history-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 25px;
    }

    /* ========================================================= */
    /* HEADER */
    /* ========================================================= */

    .page-header {
        background: linear-gradient(135deg, #185c37, #217a4b);
        color: white;
        border-radius: 16px;
        padding: 25px 28px;
        margin-bottom: 22px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
    }

    .page-title {
        font-size: 27px;
        font-weight: 700;
        margin: 0;
    }

    .page-subtitle {
        margin-top: 5px;
        font-size: 14px;
        opacity: 0.9;
    }


    /* ========================================================= */
    /* SUMMARY */
    /* ========================================================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 18px;
        box-shadow: 0 3px 10px rgba(0,0,0,0.04);
    }

    .summary-label {
        color: #6b7280;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .summary-value {
        margin-top: 7px;
        font-size: 26px;
        font-weight: 700;
        color: #1f2937;
    }


    /* ========================================================= */
    /* HISTORY CARD */
    /* ========================================================= */

    .history-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0,0,0,0.04);
    }

    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 20px;
        border-bottom: 1px solid #e5e7eb;
    }

        .history-header h2 {
            margin: 0;
            font-size: 18px;
            color: #374151;
        }

    .back-button {
        text-decoration: none;
        background: #f3f4f6;
        border: 1px solid #d1d5db;
        color: #374151;
        padding: 8px 13px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
    }

        .back-button:hover {
            background: #e5e7eb;
        }


    /* ========================================================= */
    /* TABLE */
    /* ========================================================= */

    .table-wrapper {
        overflow-x: auto;
    }

    .history-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
        font-size: 13px;
    }

        .history-table thead {
            background: #f8fafc;
        }

        .history-table th {
            padding: 13px 14px;
            text-align: left;
            white-space: nowrap;
            color: #374151;
            font-size: 12px;
            font-weight: 700;
            border-bottom: 1px solid #e5e7eb;
        }

        .history-table td {
            padding: 13px 14px;
            color: #4b5563;
            border-bottom: 1px solid #f0f0f0;
            white-space: nowrap;
        }

        .history-table tbody tr:hover {
            background: #fafafa;
        }

        .history-table tbody tr:last-child td {
            border-bottom: none;
        }

    .file-name {
        font-weight: 600;
        color: #1f2937 !important;
    }

    .date-cell {
        color: #6b7280 !important;
    }

    .imported-cell {
        font-weight: 700;
        color: #166534 !important;
    }

    .skipped-cell {
        font-weight: 700;
        color: #92400e !important;
    }


    /* ========================================================= */
    /* EMPTY */
    /* ========================================================= */

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #6b7280;
    }

    .empty-title {
        font-size: 18px;
        font-weight: 700;
        color: #374151;
        margin-bottom: 6px;
    }

    .empty-text {
        font-size: 13px;
    }


    /* ========================================================= */
    /* RESPONSIVE */
    /* ========================================================= */

    @@media (max-width: 900px) {

        .summary-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 600px) {

        .history-page {
            padding: 15px;
        }

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .page-header {
            padding: 22px;
        }

        .page-title {
            font-size: 23px;
        }

        .history-header {
            align-items: flex-start;
            gap: 10px;
            flex-direction: column;
        }
    }

</style>


<div class="history-page">


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="page-header">

        <div class="page-title">
            Excel Import History
        </div>

        <div class="page-subtitle">
            Paddy MIS • Previous Excel Imports
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SUMMARY CARDS -->
    <!-- ========================================================= -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-label">
                Total Imports
            </div>

            <div class="summary-value">
                @totalImports.ToString("N0")
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Excel Rows
            </div>

            <div class="summary-value">
                @totalRows.ToString("N0")
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Imported
            </div>

            <div class="summary-value">
                @totalImported.ToString("N0")
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-label">
                Skipped / Duplicate
            </div>

            <div class="summary-value">
                @totalSkipped.ToString("N0")
            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- HISTORY TABLE -->
    <!-- ========================================================= -->

    <div class="history-card">

        <div class="history-header">

            <h2>
                Import Records
            </h2>

            <a href="/ExcelImport"
               class="back-button">

                ← Back to Import

            </a>

        </div>


        @if (Model != null && Model.Rows.Count > 0)
        {
            <div class="table-wrapper">

                <table class="history-table">

                    <thead>

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                File Name
                            </th>

                            <th>
                                Import Date
                            </th>

                            <th>
                                Excel Rows
                            </th>

                            <th>
                                Imported
                            </th>

                            <th>
                                Skipped / Duplicate
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (DataRow row in Model.Rows)
                        {
                            <tr>

                                <td>
                                    @row["ImportID"]
                                </td>

                                <td class="file-name">

                                    @row["FileName"]

                                </td>

                                <td class="date-cell">

                                    @if (row["ImportDate"] != DBNull.Value)
                                    {
                                        @Convert.ToDateTime(
                                            row["ImportDate"]
                                        ).ToString(
                                            "dd-MMM-yyyy hh:mm tt"
                                        )
                                    }

                                </td>

                                <td>

                                    @if (row["TotalRows"] != DBNull.Value)
                                    {
                                        @Convert.ToInt32(
                                            row["TotalRows"]
                                        ).ToString("N0")
                                    }
                                    else
                                    {
                                        @:0
                                    }

                                </td>

                                <td class="imported-cell">

                                    @if (row["ImportedRows"] != DBNull.Value)
                                    {
                                        @Convert.ToInt32(
                                            row["ImportedRows"]
                                        ).ToString("N0")
                                    }
                                    else
                                    {
                                        @:0
                                    }

                                </td>

                                <td class="skipped-cell">

                                    @if (row["SkippedRows"] != DBNull.Value)
                                    {
                                        @Convert.ToInt32(
                                            row["SkippedRows"]
                                        ).ToString("N0")
                                    }
                                    else
                                    {
                                        @:0
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-title">
                    No import history
                </div>

                <div class="empty-text">
                    Import an Excel file and the import record
                    will appear here.
                </div>

            </div>
        }

    </div>

</div>